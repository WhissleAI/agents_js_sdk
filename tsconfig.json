{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // ES2021.WeakRef is for livekit-client's own .d.ts, which references
    // FinalizationRegistry. We keep the ES2020 target and check its types for
    // real (skipLibCheck stays off) rather than skip-checking the dependency.
    "lib": ["ES2020", "ES2021.WeakRef", "DOM", "DOM.Iterable"],
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist"
  },
  "include": ["src", "test"]
}
